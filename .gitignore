# fastlane run artefacts. The listing itself — fastlane/metadata and
# fastlane/screenshots — is the point of keeping it in the repo, so it is
# committed rather than ignored.
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
# Regenerated by `fastlane docs` from the Fastfile, so it is output, not source.
fastlane/README.md

